# Copy to .env_install_test and fill in. Used by tests/docker_install_package/run.sh and run_local_dist.sh
# No quotes: docker --env-file passes values literally.
ACCESS_TOKEN=
LEXIS_PROJECT=EU-00-00
RESOURCE_NAME=VLQ-EU
# Optional: backend (cluster) name, e.g. VLQ; shots per job; 1 = no jobs
BACKEND_NAME=
SHOTS=100
SKIP_QPU=
