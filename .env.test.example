# =======================
# QAAS
# =======================
# QHEAppE environment for testing

# LEXIS project identifier
QAAS_PROJECT=my_lexis_project

# Accounting string / resource name for the target IQM backend
QAAS_RESOURCE=EQE1-CZ-P0001

# Known-invalid resource name, used for negative test cases
QAAS_INVALID_RESOURCE=NON-EXISTENT-0000

# Pre-obtained LEXIS access token (interactive login can't be automated
# in CI - get this token via an interactive LexisSession() login once,
# or via whatever service-account/offline-token flow LEXIS provides)
QAAS_TOKEN=

# JSON string with additional arguments for QProviderDev's instance for method 'get_backend'
ADDITIONAL_BACKEND_ARGS=


# ======================
# QHEAPPE
# ======================
# QHEAppE environment for testing

LEXIS_TOKEN=
QHEAPPE_PROJECT=vlq_dev_project
QHEAPPE_RESOURCE=VLQ-CZ-dev-alpha
QHEAPPE_INVALID_RESOURCE=NON-EXISTENT-0000
QHEAPPE_BACKEND=VLQ
QHEAPPE_LEXIS_API_URL=https://api.lexis.tech
QHEAPPE_CLIENT_ARGS={}
# set 0 for mock backends (VLQ-IQM-QCCSW-MOCK)
QHEAPPE_MIN_FIDELITY=0.85
QHEAPPE_JOB_TIMEOUT=600
